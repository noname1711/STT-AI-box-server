#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

command -v cargo >/dev/null

cargo run -p stt-cli -- --workspace-root "$ROOT" setup
cargo run -p stt-cli -- --workspace-root "$ROOT" download-models
cargo run -p stt-cli -- --workspace-root "$ROOT" verify-assets
cargo run -p stt-cli -- --workspace-root "$ROOT" check-capu

echo "Workspace bootstrapped. Runtime initialized and locked assets verified."
