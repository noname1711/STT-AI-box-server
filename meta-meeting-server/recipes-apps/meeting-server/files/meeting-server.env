# HL Meet v19.6.0 — locked VIT STT baseline + OPUS realtime translation
# Browser sends continuous PCM16 mono 16 kHz. VIT is the only ASR stack.

MEETING_ALLOW_PAGES_DEV=0
MEETING_ALLOWED_WEB_ORIGINS=https://meet-hl.pages.dev,https://floral-river-f5b3.trungdungx06.workers.dev
MEETING_ALLOW_LOCALHOST_DEV=1
# Production uses explicit VI/EN selection. Native auto decodes both models
# sequentially and is intentionally disabled to prevent accidental 2x ASR work.
MEETING_ALLOW_AUTO_LANGUAGE=0

# Non-destructive multi-client cross-talk hold.
MEETING_PRE_STT_GATE_HOLD_MS=500
MEETING_PRE_STT_GATE_PENDING_CAPACITY=128
MEETING_PRE_STT_AVG_RMS_RATIO=1.60
MEETING_PRE_STT_PEAK_RMS_RATIO=1.25
MEETING_PRE_STT_DESTRUCTIVE=0

# Capture / VAD.
MEETING_STREAM_PRE_ROLL_MS=800
MEETING_STREAM_ONSET_MS=80
MEETING_STREAM_HANGOVER_MS=900
MEETING_STREAM_SOFT_SILENCE_MS=400
MEETING_STREAM_MIN_THRESHOLD=0.0045
MEETING_STREAM_NOISE_MULTIPLIER=2.0
MEETING_STREAM_MIN_PEAK=0.009

# Transport packets are reframed into exact 20 ms / 640-byte PCM units before VAD.
# The message cap is deliberately much larger than a normal browser packet and
# protects the Python event loop from pathological single-message bursts.
MEETING_WS_MAX_PCM_MESSAGE_BYTES=262144
MEETING_WS_SEND_TIMEOUT_SECONDS=1.5
MEETING_PCM_REFRAME_YIELD_FRAMES=32
# Bound LAN fan-in / buggy-client PCM acceleration without affecting normal 1x audio.
MEETING_MAX_CLIENTS=16
MEETING_PCM_MAX_REALTIME_FACTOR=4.0
MEETING_PCM_RATE_BURST_SECONDS=10.0

# v19.2: bounded ambient learning from FINAL model-confirmed no-speech.
MEETING_STREAM_NOISE_LEARN_ENABLED=0
MEETING_STREAM_NOISE_LEARN_MIN_MS=1800
MEETING_STREAM_NOISE_REJECT_BLEND=0.35
MEETING_STREAM_NOISE_MAX_FLOOR=0.0065
MEETING_MIN_UTTERANCE_MS=160

# Long-form segmentation. These are inference-window limits, never speaking-turn limits.
MEETING_SEGMENT_SOFT_SECONDS=10
MEETING_SEGMENT_HARD_SECONDS=15
MEETING_SEGMENT_OVERLAP_MS=1200
MEETING_LOGICAL_TURN_GAP_MS=1500
MEETING_STT_QUEUE_CAPACITY=0

# FINAL PCM/WAV files live on persistent NVMe, not /run tmpfs. The queue may
# remain logically no-drop without turning inference backlog into RAM pressure.
MEETING_STATE_DIR=/var/lib/meeting-server
# Stop starting new capture below this free-space reserve; current captured FINAL
# is flushed first so disk pressure degrades explicitly instead of filling rootfs.
MEETING_STATE_MIN_FREE_MB=1024

# LIVE VIT lane: short PCM snapshots, lower priority than FINAL.
MEETING_PARTIAL_ENABLED=0
MEETING_PARTIAL_MIN_AUDIO_MS=1200
MEETING_PARTIAL_INTERVAL_MS=900
MEETING_PARTIAL_WINDOW_MS=5000
MEETING_PARTIAL_TIMEOUT_SECONDS=60

# FINAL VIT lane: server materializes long rolling WAV windows.
MEETING_FINAL_LEFT_CONTEXT_SECONDS=12
MEETING_FINAL_MAX_WINDOW_SECONDS=28
MEETING_FINAL_MERGE_TAIL_WORDS=100

# Native VIT-STT HTTP backend.
MEETING_VIT_STT_HTTP_URL=http://127.0.0.1:8091
MEETING_VIT_STT_CONNECT_TIMEOUT=120
MEETING_VIT_STT_REQUEST_TIMEOUT=180

# HL Meet v19.4 accuracy-first post-ASR translation profile.
# canonical_text stays untouched. display_text may use ITN, but NMT receives a
# separate translation_input_text with punctuation/case only so display-number
# heuristics can never alter translation semantics.
MEETING_TRANSLATION_ENABLED=1
MEETING_TRANSLATION_TIMEOUT_SECONDS=300
MEETING_TRANSLATION_IDLE_POLL_MS=120

# v19.6 realtime UX: confirmed VIT LIVE text gets bounded OPUS beam-1 preview;
# authoritative logical FINAL uses the OPUS model's wider search beam. Disable
# the old cumulative lane so stale document jobs cannot monopolize translation.
MEETING_TRANSLATION_PROGRESSIVE_ENABLED=0
MEETING_TRANSLATION_PROGRESSIVE_FIRST_WORDS=24
MEETING_TRANSLATION_PROGRESSIVE_MIN_NEW_WORDS=24
MEETING_TRANSLATION_LIVE_PREVIEW_ENABLED=0
MEETING_TRANSLATION_LIVE_MIN_WORDS=6
MEETING_TRANSLATION_LIVE_MIN_INTERVAL_MS=600
MEETING_TRANSLATION_LIVE_TIMEOUT_SECONDS=5
MEETING_TRANSLATION_LIVE_MAX_WORDS=24

# Keep the audited sentence/clause-aware FINAL chunking until target benchmarks justify tuning.
MEETING_TRANSLATION_CHUNK_TRIGGER_WORDS=72
MEETING_TRANSLATION_CHUNK_WORDS=96
MEETING_TRANSLATION_CHUNK_MIN_TAIL_WORDS=18
MEETING_TRANSLATION_RECOVERY_MAX_DEPTH=3

# Do not run unconditional reverse translation on every FINAL chunk. Production
# relies on deterministic anchors/repetition/completeness gates + bounded recovery.
# Round-trip remains diagnostic/selective only; never put it on the realtime path.
MEETING_TRANSLATION_ROUNDTRIP_QA=0
MEETING_TRANSLATION_ROUNDTRIP_MIN_SIMILARITY=0.34
MEETING_TRANSLATION_ROUNDTRIP_MIN_WORDS=5
MEETING_TRANSLATION_ROUNDTRIP_MAX_WORDS=90

# OPUS authoritative FINAL uses the model beam configured in native code
# (EN->VI beam 4, VI->EN beam 6). LIVE uses explicit *-live-greedy beam 1.
MEETING_TRANSLATION_PRIMARY_GREEDY=0

# v19.6 production translation is the last-good OPUS CTranslate2 pair on CPU.
# Keep it in the isolated translator service, 3 threads, nice=10. LIVE is skipped
# whenever authoritative STT/FINAL translation is busy, preserving VIT priority.
MEETING_TRANSLATOR_DEVICE=cpu
MEETING_TRANSLATOR_SOCKET=/run/meeting-translator/translator.sock
MEETING_TRANSLATOR_CONNECT_TIMEOUT_SECONDS=180
MEETING_TRANSLATOR_CUDA_COMPUTE_TYPE=int8_float16
MEETING_TRANSLATOR_CUDA_CPU_FALLBACK=0
# Native proxy kills/restarts a wedged inference rather than holding the one lane for 330s.
MEETING_TRANSLATOR_DAEMON_REQUEST_TIMEOUT_SECONDS=120
# LIVE requests use a separate bounded decoder budget; FINAL keeps the full 512-token ceiling.
MEETING_TRANSLATOR_LIVE_MAX_DECODING_LENGTH=192
# Retain the last-good OPUS host-thread count; do not increase before measuring
# VIT latency and CPU contention on target.
MEETING_TRANSLATOR_THREADS=2
# Keep OPUS below authoritative VIT in the Linux scheduler when both are busy.
MEETING_TRANSLATOR_NICE=10
# v19.6 ships an OPUS-only model pack. This explicit opt-in is required by the
# retained dual-family native loader; MADLAD is absent, so no silent downgrade exists.
MEETING_TRANSLATOR_ALLOW_OPUS_FALLBACK=0
# Validation-only domain anchors. These strings are never substituted into NMT input.
MEETING_TRANSLATION_PROTECTED_TERMS=HL Meet,NVIDIA,Jetson,Orin Nano,CUDA,CTranslate2,NVMe,MADLAD,Gipformer,Parakeet
# The heavy model lifecycle/restart backoff is owned by meeting-translator.service.
# meeting-server only reconnects a Unix socket, so keep client-side recovery short;
# a legacy 30->120s backoff would add avoidable FINAL latency after the isolated
# service has already recovered.
MEETING_TRANSLATOR_RESTART_BACKOFF_SECONDS=5
MEETING_TRANSLATOR_RESTART_BACKOFF_MAX_SECONDS=10

# Vietnamese presentation-only written form. Never feed this back to VIT
# rolling merge/correction.
MEETING_VI_WRITTEN_FORM_ENABLED=1
MEETING_VI_ITN_PERCENT_ENABLED=1
MEETING_VI_ITN_COMMON_ENABLED=1

# V20 anonymous speaker tracking.
# Runs only after authoritative VIT FINAL STT has committed.
MEETING_SPEAKER_ENABLED=0
MEETING_SPEAKER_THRESHOLD=0.60
MEETING_SPEAKER_TIMEOUT_SECONDS=60
# Do not enroll/re-ID sub-second snippets; canonical STT is unaffected.
MEETING_SPEAKER_MIN_AUDIO_MS=1000
MEETING_SPEAKER_NICE=15
