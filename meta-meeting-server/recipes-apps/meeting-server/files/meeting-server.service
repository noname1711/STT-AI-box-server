[Unit]
Description=HL Meet V20 transition STT-only API server
After=network-online.target meeting-vit-stt.service
Wants=network-online.target meeting-vit-stt.service
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
User=hungle
Group=hungle
WorkingDirectory=/opt/meeting/server

Environment=PYTHONUNBUFFERED=1
Environment=MEETING_HTTP_PORT=8080
Environment=MALLOC_ARENA_MAX=2
Environment=OMP_NUM_THREADS=1
EnvironmentFile=/etc/meeting-server/meeting-server.env

RuntimeDirectory=meeting-server
RuntimeDirectoryMode=0755
StateDirectory=meeting-server
StateDirectoryMode=0750

ExecStart=/usr/bin/python3 /opt/meeting/server/server.py

Restart=always
RestartSec=3
TimeoutStartSec=240
TimeoutStopSec=30
KillSignal=SIGTERM

# v19.4.9: MADLAD no longer belongs to this cgroup. Protect the product-control
# plane (HTTP/WebSocket/mic/VAD plus the small VIT bridge) from translation OOM.
MemoryHigh=768M
MemoryMax=1536M
OOMPolicy=continue
OOMScoreAdjust=-250
TasksMax=256
LimitNOFILE=4096

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
